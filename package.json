{
  "name": "nyx-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight desktop pet that runs on macOS and Windows.",
  "main": "desktop/electron/main.js",
  "scripts": {
    "start": "electron .",
    "start:electron": "electron .",
    "start:mac-native": "./desktop/run-desktop-pet.sh",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win portable --config.win.signAndEditExecutable=false",
    "dist:win:installer": "electron-builder --win"
  },
  "build": {
    "appId": "com.nyx.pet",
    "productName": "Nyx Pet",
    "files": [
      "desktop/**/*",
      "actions/**/*",
      "skills/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
